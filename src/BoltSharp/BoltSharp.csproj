<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Protocol core. Must stay free of ASP.NET Core, Neo4j.Driver,
      LatticeDbSharp and native dependencies.
    -->
    <AssemblyName>BoltSharp</AssemblyName>
    <RootNamespace>BoltSharp</RootNamespace>
    <Version>1.0.0-preview.1</Version>
    <PackageId>BoltSharp</PackageId>
    <Description>An independent .NET implementation of the Bolt 5.8 / PackStream 1.0 wire protocol for building compatible server endpoints.</Description>
    <Authors>BoltSharp Contributors</Authors>
    <Copyright>Copyright (c) 2024 BoltSharp Contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/jenolaszlo-sketch/bolt-sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jenolaszlo-sketch/bolt-sharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>bolt;packstream;neo4j;protocol;database;graph</PackageTags>
    <PackageReleaseNotes>See release notes for version 1.0.0-preview.1</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <DebugType>embedded</DebugType>
    <EmbedAllSources>true</EmbedAllSources>
    <!--
      Debug symbols and sources are embedded in BoltSharp.dll (DebugType/EmbedAllSources
      above), so there is no separate .pdb to ship. A separate snupkg would therefore be
      empty, and newer SDKs (>= 10) fail the symbols package with NU5017 ("Cannot create a
      package that has no dependencies nor content"), failing the whole pack. The embedded
      symbols already provide full debuggability from the shipped assembly.
    -->
    <IncludeSymbols>false</IncludeSymbols>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Package README and LICENSE come from the repository root, so packaging is
      self-contained and does not depend on a prior copy step in the workflow.
    -->
    <None Include="$(MSBuildThisFileDirectory)..\..\README.md" Pack="true" PackagePath="\" Link="README.md" />
    <None Include="$(MSBuildThisFileDirectory)..\..\LICENSE" Pack="true" PackagePath="\" Link="LICENSE" />
  </ItemGroup>

</Project>
