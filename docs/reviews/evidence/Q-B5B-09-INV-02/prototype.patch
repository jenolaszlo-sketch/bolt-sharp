diff --git a/src/BoltSharp/Transport/BoltTerminalClose.cs b/src/BoltSharp/Transport/BoltTerminalClose.cs
new file mode 100644
--- /dev/null
+++ b/src/BoltSharp/Transport/BoltTerminalClose.cs
@@ -0,0 +1,183 @@
+using System.Diagnostics;
+using System.Net.Security;
+using System.Net.Sockets;
+
+namespace BoltSharp.Transport;
+
+// Investigation constants. These values are not production defaults.
+internal static class BoltTerminalClose
+{
+    internal const int DrainSlots = 2;
+    internal const int ScratchBytes = 2048;
+    internal const int PlaintextLimit = 8192;
+    internal const int CiphertextLimit = 32768;
+    internal const int DrainMilliseconds = 75;
+    internal const int TotalMilliseconds = 300;
+
+    internal static async Task RunAsync(TcpClient client, Stream stream, BoundedTlsInput? tlsInput,
+        SemaphoreSlim permits, string connectionId, Func<CancellationToken, Task> write,
+        CancellationToken shutdown)
+    {
+        var started = Stopwatch.GetTimestamp();
+        var phase = "write";
+        var outcome = "fault";
+        var bytes = 0;
+        var writeMs = -1d;
+        var admitted = false;
+        using var lifetime = CancellationTokenSource.CreateLinkedTokenSource(shutdown);
+        lifetime.CancelAfter(TotalMilliseconds);
+        using var drain = CancellationTokenSource.CreateLinkedTokenSource(lifetime.Token);
+        // SslStream.ShutdownAsync has no token. Close the owned socket when the budget
+        // expires and always await the actual operation before returning.
+        using var abort = lifetime.Token.UnsafeRegister(static state => ((TcpClient)state!).Dispose(), client);
+        try
+        {
+            await write(lifetime.Token).ConfigureAwait(false);
+            writeMs = Stopwatch.GetElapsedTime(started).TotalMilliseconds;
+            phase = "admission";
+            lifetime.Token.ThrowIfCancellationRequested();
+            admitted = permits.Wait(0);
+            if (!admitted)
+            {
+                outcome = "capacity";
+                return;
+            }
+
+            phase = "shutdown";
+            drain.CancelAfter(DrainMilliseconds);
+            using var stopDrain = drain.Token.UnsafeRegister(static state => ((TcpClient)state!).Dispose(), client);
+            if (stream is SslStream ssl)
+            {
+                await ssl.ShutdownAsync().ConfigureAwait(false);
+                tlsInput!.StartLimit(CiphertextLimit);
+            }
+            else
+            {
+                client.Client.Shutdown(SocketShutdown.Send);
+            }
+
+            TerminalCloseTrace.Log.DrainStarted(connectionId, tlsInput is not null);
+            phase = "drain";
+            var buffer = new byte[ScratchBytes];
+            while (bytes < PlaintextLimit)
+            {
+                drain.Token.ThrowIfCancellationRequested();
+                var count = await stream.ReadAsync(buffer.AsMemory(0, Math.Min(buffer.Length, PlaintextLimit - bytes)),
+                    drain.Token).ConfigureAwait(false);
+                if (count == 0)
+                {
+                    outcome = tlsInput is null ? "peer-eof" : tlsInput.TransportEof ? "tls-transport-eof" : "tls-eof";
+                    return;
+                }
+
+                bytes += count;
+            }
+
+            outcome = "byte-cap";
+        }
+        catch (Exception error) when (error is IOException or SocketException or OperationCanceledException or ObjectDisposedException)
+        {
+            outcome = shutdown.IsCancellationRequested ? "server-cancelled"
+                : lifetime.IsCancellationRequested ? "total-deadline"
+                : error is TlsInputLimitException ? "cipher-cap"
+                : drain.IsCancellationRequested ? "phase-deadline"
+                : "transport-error";
+            if (phase == "write")
+            {
+                if (lifetime.IsCancellationRequested)
+                    throw new OperationCanceledException(lifetime.Token);
+                throw;
+            }
+        }
+        finally
+        {
+            client.Dispose();
+            if (admitted)
+            {
+                permits.Release();
+            }
+
+            TerminalCloseTrace.Log.Finished(connectionId, phase, outcome, bytes, tlsInput?.WireBytes ?? 0,
+                writeMs, Stopwatch.GetElapsedTime(started).TotalMilliseconds);
+        }
+    }
+}
+
+internal sealed class TerminalCloseTrace
+{
+    internal static readonly TerminalCloseTrace Log = new();
+    private readonly DiagnosticListener _listener = new("BoltSharp-INV02-Terminal");
+
+    internal void DrainStarted(string id, bool tls)
+    {
+        if (_listener.IsEnabled("DrainStarted"))
+            _listener.Write("DrainStarted", new { id, tls });
+    }
+
+    internal void PendingWrite(string id, int payloadBytes)
+    {
+        if (_listener.IsEnabled("PendingWrite"))
+            _listener.Write("PendingWrite", new { id, payloadBytes });
+    }
+
+    internal void Finished(string id, string phase, string outcome, int bytes, int wireBytes,
+        double writeMs, double terminalMs)
+    {
+        if (_listener.IsEnabled("Finished"))
+            _listener.Write("Finished", new { id, phase, outcome, bytes, wireBytes, writeMs, terminalMs });
+    }
+}
+
+internal sealed class TlsInputLimitException : IOException;
+
+// Preserve exclusive SslStream ownership. Bound inner-stream input without reading it
+// concurrently with TLS. Previously buffered TLS bytes remain subject to the output cap.
+internal sealed class BoundedTlsInput(Stream inner) : Stream
+{
+    private int? _limit;
+    internal int WireBytes { get; private set; }
+    internal bool TransportEof { get; private set; }
+
+    internal void StartLimit(int limit) => _limit = limit;
+
+    private int Limit(int requested)
+    {
+        if (_limit is not int ceiling || requested == 0)
+            return requested;
+        var available = ceiling - WireBytes;
+        return available > 0 ? Math.Min(requested, available) : throw new TlsInputLimitException();
+    }
+
+    private int Observe(int count, int requested)
+    {
+        if (_limit.HasValue)
+            WireBytes += count;
+        if (requested > 0 && count == 0)
+            TransportEof = true;
+        return count;
+    }
+
+    public override int Read(byte[] buffer, int offset, int count)
+        => Observe(inner.Read(buffer, offset, Limit(count)), count);
+
+    public override async ValueTask<int> ReadAsync(Memory<byte> buffer, CancellationToken cancellationToken = default)
+        => Observe(await inner.ReadAsync(buffer[..Limit(buffer.Length)], cancellationToken).ConfigureAwait(false), buffer.Length);
+
+    public override Task<int> ReadAsync(byte[] buffer, int offset, int count, CancellationToken cancellationToken)
+        => ReadAsync(buffer.AsMemory(offset, count), cancellationToken).AsTask();
+
+    public override bool CanRead => inner.CanRead;
+    public override bool CanWrite => inner.CanWrite;
+    public override bool CanSeek => false;
+    public override long Length => throw new NotSupportedException();
+    public override long Position { get => throw new NotSupportedException(); set => throw new NotSupportedException(); }
+    public override void Flush() => inner.Flush();
+    public override Task FlushAsync(CancellationToken cancellationToken) => inner.FlushAsync(cancellationToken);
+    public override void Write(byte[] buffer, int offset, int count) => inner.Write(buffer, offset, count);
+    public override ValueTask WriteAsync(ReadOnlyMemory<byte> buffer, CancellationToken cancellationToken = default)
+        => inner.WriteAsync(buffer, cancellationToken);
+    public override Task WriteAsync(byte[] buffer, int offset, int count, CancellationToken cancellationToken)
+        => inner.WriteAsync(buffer, offset, count, cancellationToken);
+    public override long Seek(long offset, SeekOrigin origin) => throw new NotSupportedException();
+    public override void SetLength(long value) => throw new NotSupportedException();
+}
