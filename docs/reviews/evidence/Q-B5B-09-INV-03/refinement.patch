diff --git a/src/BoltSharp/Transport/Inv03Probe.cs b/src/BoltSharp/Transport/Inv03Probe.cs
new file mode 100644
--- /dev/null
+++ b/src/BoltSharp/Transport/Inv03Probe.cs
@@ -0,0 +1,13 @@
+using System.Net.Sockets;
+
+namespace BoltSharp.Transport;
+
+// Isolated qualification hooks, configured only in the in-process test fixture.
+internal static class Inv03Probe
+{
+    internal static Action<string, string, object?>? Observer = null;
+    internal static Func<string, SafeSocketHandle, CancellationToken, ValueTask>? EncryptedWrite = null;
+
+    internal static void Publish(string name, string connectionId, object? value)
+        => Observer?.Invoke(name, connectionId, value);
+}
