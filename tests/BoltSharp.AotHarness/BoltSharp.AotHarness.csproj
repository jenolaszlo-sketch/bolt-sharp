<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Single consumer TFM per invocation, selected with -p:ConsumerTfm=net8.0|net10.0.
      This keeps each build single-targeted so neither SDK ever has to evaluate a TFM it
      does not support (a net8.0;net10.0 multi-target project fails under the .NET 8 SDK).
      The library itself remains net8.0.
    -->
    <ConsumerTfm Condition="'$(ConsumerTfm)' == ''">net8.0</ConsumerTfm>
    <TargetFramework>$(ConsumerTfm)</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BoltSharp\BoltSharp.csproj" />
  </ItemGroup>

</Project>